APP_NAME=Hospital AI Service
APP_ENV=local
APP_HOST=127.0.0.1
APP_PORT=8000
APP_DEBUG=true
LOG_LEVEL=INFO

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=hospital_ai_db
DB_USER=root
DB_PASSWORD=请替换为你的MySQL密码
DB_ECHO=false

JWT_SECRET=replace_with_the_same_base64_secret_as_java_service
JWT_ALGORITHM=HS256

# 阿里云百炼
DASHSCOPE_API_KEY=replace_with_your_bailian_api_key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen3.7-plus
DASHSCOPE_TIMEOUT_SECONDS=30